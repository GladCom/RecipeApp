@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using RecipeApp.Services

<main>
   
    
    <input class="form-control recipe-title-input mb-4"
           placeholder="Введите название рецепта"
           />

    @* ЗАВТРАК *@
    <div style="margin-bottom: 20px;">
        <label>
            <input type="checkbox" @bind="isBreakfast" />
            <strong class="h3_Style">🍳 Завтрак</strong>
        </label>

       
        
        @if (isBreakfast)
        {
            <div style="margin-left: 25px; margin-right: 25px; margin-top: 10px;">
                @for (int i = 0; i < breakfastItems.Count; i++)
                {
                    var index = i;
                    <div style="margin-bottom: 15px; padding: 10px; border: 1px solid #ddd; border-radius: 8px;">
                        <div style="display: flex; gap: 10px;">
                            <select @bind="breakfastItems[index]" @bind:event="onchange" style="flex: 1; padding: 8px;">
                                <option value="0">-- Выберите блюдо --</option>
                                @foreach (var recipe in AllRecipes)
                                {
                                    <option value="@recipe.Id">@recipe.Title</option>
                                }
                            </select>
                            @* Кнопка удаления *@
                            <button @onclick="() => RemoveBreakfastItem(index)"
                                    style="background: #dc3545; color: white; border: none; padding: 8px 12px; border-radius: 5px; cursor: pointer;">
                                Удалить
                            </button>
                        </div>
                        @* ингридиенты если выбран не 0 индекс в списке *@
                        @if (breakfastItems[index] > 0)
                        {
                            var selectedRecipe = AllRecipes.FirstOrDefault(r => r.Id == breakfastItems[index]);
                            if (selectedRecipe != null)
                            {
                                <div style="margin-top: 10px; padding: 8px; background: #f0f0f0; border-radius: 5px;">
                                    @* Блок ингридиетов *@
                                    <strong>📝 Ингредиенты:</strong>
                                    @if (selectedRecipe.Ingredients != null && selectedRecipe.Ingredients.Any())
                                    {
                                        <ul style="margin: 5px 0 0 0; padding-left: 20px;">
                                            @* Что вывовыдим в ингидиентах  *@
                                            @foreach (var ingredient in selectedRecipe.Ingredients)
                                            {
                                                <li style="margin-bottom: 10px; ">
                                                    @ingredient.Name -
                                                    @ingredient.Amount @UnitTypeUtils.GetUnitLabel(ingredient.Unit)
                                                    @ingredient.Protein белков;
                                                    @ingredient.Fat - жиров;
                                                    @ingredient.Carbs -углеводов;
                                                    @ingredient.Calories - калл.

                                                    @if (ingredient.Calories > 0)
                                                    {
                                                        <span style="color: #666;"> (⚡ @ingredient.Calories ккал)</span>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <div style="margin-top: 5px;">Нет ингредиентов</div>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
                <button @onclick="AddBreakfastItem">+ Добавить блюдо</button>
            </div>
        }
    </div>


    @* КНОПКИ *@
    <div class="no-print">
        <button class="btn btn-primary add-button" @onclick ="Save" style="margin-right: 10px;">💾 Сохранить</button>
        <button class="btn btn-primary add-button" @onclick="GoBack" style="margin-right: 10px;">⬅️ Вернуться назад</button>
        <button class="btn btn-primary add-button" @onclick="Print">🖨️ К печати</button>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div style="margin-top: 20px; padding: 10px; background: lightgreen;">
            @message
        </div>
    }
</main>

