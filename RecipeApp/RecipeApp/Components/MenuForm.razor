
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<main>
    <h3>Планирование питания</h3>

    @* ЗАВТРАК *@
    <div style="margin-bottom: 20px;">
        <label>
            <input type="checkbox" @bind="isBreakfast" />
            <strong>🍳 Завтрак</strong>
        </label>

       
        @if (isBreakfast)
        {
            <div style="margin-left: 25px; margin-top: 10px;">
                @for (int i = 0; i < breakfastItems.Count; i++)
                {
                    var index = i;
                    <div style="margin-bottom: 8px;">
                        <select @bind="breakfastItems[index]" @bind:event="onchange">
                            <option value="">-- Выберите блюдо --</option>
                            @foreach (var recipe in AllRecipes)
                            {
                                <option value="@recipe.Id">@recipe.Title</option>
                            }
                        </select>
                    </div>
                }
                <button @onclick="AddBreakfastItem">+ Добавить</button>
            </div>
        }
    </div>


@* КНОПКИ *@
<div>
    <button @onclick="Save" style="margin-right: 10px;">💾 Сохранить</button>
    <button @onclick="GoBack" style="margin-right: 10px;">⬅️ Вернуться назад</button>
    <button @onclick="Print">🖨️ К печати</button>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div style="margin-top: 20px; padding: 10px; background: lightgreen;">
        @message
    </div>
}
</main>

